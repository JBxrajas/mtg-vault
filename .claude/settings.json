{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-check.sh",
            "statusMessage": "Checking docs before commit..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vercel-deploy-guard.sh",
            "statusMessage": "Checking the Vercel deployment budget..."
          }
        ]
      }
    ]
  }
}
