{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet HEAD^ HEAD -- . ../../packages/shared ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
