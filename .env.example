# Copy to .env.local (git-ignored). `neon env pull` fills the Neon values.

# Neon: pooled connection for the API, direct connection for migrations and the import job.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# API auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the API: http://localhost:3001 locally, https://mtg-vault-api.vercel.app in production.
BETTER_AUTH_URL=http://localhost:3001

# Browser origins allowed to call the API, comma-separated. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
